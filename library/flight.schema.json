{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-tasting-kitchen.example/schema/flight-2.0.0.json",
  "title": "Model Tasting Kitchen flight v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "recordCompatibility", "id", "title", "family", "summary", "whyItExists", "evidenceBasis", "effortEstimate", "version", "status", "setup", "dishes"],
  "properties": {
    "formatVersion": {"const": "2.0.0"},
    "recordCompatibility": {"$ref": "#/$defs/recordCompatibility"}, "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "family": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "whyItExists": {"$ref": "#/$defs/text"},
    "evidenceBasis": {"$ref": "#/$defs/evidenceBasis"}, "effortEstimate": {"$ref": "#/$defs/effort"}, "version": {"$ref": "#/$defs/version"}, "status": {"enum": ["ready", "draft", "retired"]}, "setup": {"$ref": "#/$defs/setup"}, "dishes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dish"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "text": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "recordCompatibility": {"type": "object", "additionalProperties": false, "required": ["recordFormat", "minimumReadableRecordFormat", "note"], "properties": {"recordFormat": {"const": "2.0.0"}, "minimumReadableRecordFormat": {"const": "1.0.0"}, "note": {"$ref": "#/$defs/text"}}},
    "effort": {"type": "object", "additionalProperties": false, "required": ["label", "minutes"], "properties": {"label": {"enum": ["short", "medium", "long"]}, "minutes": {"type": "integer", "minimum": 1, "maximum": 180}}},
    "evidenceBasis": {"type": "object", "additionalProperties": false, "required": ["grade", "types", "evidenceIds", "provenanceCaution", "claimBoundary"], "properties": {"grade": {"enum": ["strong-recurring", "strong-task-shape", "bounded-one-off", "negative-baseline"]}, "types": {"type": "array", "minItems": 1, "items": {"enum": ["expressed-preference-correction", "observed-model-encounter", "continued-accepted-artifact", "demonstrated-authored-artifact-trait", "journal-context-task-shape", "harness-specific-mechanism", "hypothesis", "one-off"]}}, "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?:CJ|MC|MCL|AO|DA|E)[0-9]{3}(?:–[0-9]{3})?$"}}, "provenanceCaution": {"$ref": "#/$defs/text"}, "claimBoundary": {"enum": ["response-preference", "task-shape", "mixed", "harness-confounded"]}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "title", "kind", "content"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "kind": {"enum": ["inline-text", "reference-image-description", "interaction-fixture"]}, "content": {"$ref": "#/$defs/text"}, "altText": {"$ref": "#/$defs/text"}}},
    "setup": {"type": "object", "additionalProperties": false, "required": ["context", "assets"], "properties": {"context": {"$ref": "#/$defs/text"}, "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}}}},
    "harness": {"type": "object", "additionalProperties": false, "required": ["mode", "mechanics", "separationNote"], "properties": {"mode": {"enum": ["none", "simulated"]}, "mechanics": {"type": "array", "items": {"enum": ["memory", "scheduler", "worker", "permission", "routing", "delivery"]}}, "separationNote": {"$ref": "#/$defs/text"}}},
    "turn": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "stage", "label", "prompt"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["prompt", "correction", "follow-up", "mode-transition"]}, "stage": {"enum": ["receive", "explore", "transform", "decide", "simulate", "verify"]}, "label": {"$ref": "#/$defs/text"}, "prompt": {"$ref": "#/$defs/text"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["kind", "title", "method"], "properties": {"kind": {"enum": ["deterministic", "human"]}, "title": {"$ref": "#/$defs/text"}, "method": {"$ref": "#/$defs/text"}}},
    "interaction": {"type": "object", "additionalProperties": false, "required": ["visualOrInteraction", "reducedMotionCheck"], "properties": {"visualOrInteraction": {"type": "boolean"}, "reducedMotionCheck": {"enum": ["required", "not-applicable"]}}},
    "dish": {"type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "activityMode", "whyItExists", "evidenceBasis", "effortEstimate", "version", "status", "setup", "harness", "turns", "observationLenses", "repeatVariationGuidance", "externalCorrectnessChecks", "interactionRequirements", "humanJudgmentRequired"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "activityMode": {"enum": ["conversation", "transformation", "presence", "memory-proactivity", "semantic-framing", "research-decision", "orchestration", "visual-interaction", "prototype-validation"]}, "whyItExists": {"$ref": "#/$defs/text"}, "evidenceBasis": {"$ref": "#/$defs/evidenceBasis"}, "effortEstimate": {"$ref": "#/$defs/effort"}, "version": {"$ref": "#/$defs/version"}, "status": {"enum": ["ready", "draft", "retired"]}, "setup": {"$ref": "#/$defs/setup"}, "harness": {"$ref": "#/$defs/harness"}, "turns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/turn"}}, "observationLenses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}, "repeatVariationGuidance": {"$ref": "#/$defs/text"}, "externalCorrectnessChecks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "interactionRequirements": {"$ref": "#/$defs/interaction"}, "humanJudgmentRequired": {"type": "boolean"}}}
  }
}
