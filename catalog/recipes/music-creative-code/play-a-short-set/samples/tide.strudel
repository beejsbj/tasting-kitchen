// A hand-written sample set for the music room: slow, in D minor, rising to one peak and ebbing away.
// Steps are separated by "// --- step N" lines. Written by hand to prove the room's loop, not cooked by a model.

// --- step 1
setcpm(24)
$: note("<d2 d2 a1 d2>").s("sine").attack(0.4).release(1.5).gain(0.7)
$: note("~ <a4 f4> ~ ~").s("triangle").room(0.6).release(0.8).gain(0.35)

// --- step 2
$: note("<d2 d2 a1 d2>").s("sine").attack(0.4).release(1.5).gain(0.7)
$: n("0 ~ 4 ~ 2 ~ <6 7> ~").scale("D4:minor").s("triangle").room(0.6).release(0.6).gain(0.4)

// --- step 3
$: note("<d2 d2 a1 d2>").s("sine").attack(0.4).release(1.5).gain(0.7)
$: n("0 ~ 4 ~ 2 ~ <6 7> ~").scale("D4:minor").s("triangle").room(0.6).release(0.6).gain(0.4)
$: s("brown").attack(1).release(1.2).lpf(600).gain(sine.range(0.1, 0.3).slow(8))

// --- step 4
$: note("<d2 [d2 f2] a1 [d2 c2]>").s("sine").attack(0.2).release(1.2).gain(0.7)
$: n("0 ~ 4 ~ 2 ~ <6 7> ~").scale("D4:minor").s("triangle").room(0.6).release(0.6).gain(0.4)
$: note("d3 ~ a3 ~").s("pulse").pw(0.2).lpf(700).attack(0.05).release(0.4).gain(0.25)
$: s("brown").attack(1).release(1.2).lpf(600).gain(0.2)

// --- step 5
$: note("<d2 [d2 f2] a1 [d2 c2]>").s("sine").attack(0.2).release(1.2).gain(0.7)
$: n("0 ~ 4 ~ 2 ~ <6 7> ~").scale("D4:minor").s("triangle").room(0.6).release(0.6).gain(0.4)
$: note("d3 ~ a3 ~").s("pulse").pw(0.2).lpf(900).attack(0.05).release(0.4).gain(0.3)
$: s("sbd ~ ~ ~").decay(0.4).gain(0.7)

// --- step 6
$: note("<d2 [d2 f2] bb1 [c2 c2]>").s("sine").attack(0.1).release(1).gain(0.7)
$: chord("<Dm7 Dm7 Bb^7 C>").voicing().s("sawtooth").lpf(sine.range(500, 1800).slow(8)).attack(0.3).release(0.8).room(0.5).gain(0.3)
$: n("0 ~ 4 ~ 2 ~ <6 7> ~").scale("D4:minor").s("triangle").room(0.6).release(0.6).gain(0.4)
$: s("sbd ~ sbd ~").decay(0.4).gain(0.7)
$: s("white*8").decay(0.04).hpf(7000).gain(0.15)

// --- step 7
$: note("<d2 [d2 f2] bb1 [c2 c2]>").s("sine").attack(0.1).release(1).gain(0.75)
$: chord("<Dm7 Dm7 Bb^7 C>").voicing().s("sawtooth").lpf(2200).attack(0.2).release(0.8).room(0.5).gain(0.3)
$: n("<[4 5 7 ~] [9 7 5 4] [5 4 2 ~] [4 2 1 ~]>").scale("D4:minor").s("supersaw").lpf(3000).attack(0.02).release(0.5).delay(0.3).gain(0.35)
$: s("sbd*4").decay(0.35).gain(0.75)
$: s("white*8").decay(0.04).hpf(7000).gain("0.2 0.1")

// --- step 8
$: note("<d2 [d2 f2] bb1 [c2 c2]>").s("sine").attack(0.1).release(1).gain(0.75)
$: chord("<Dm7 Dm7 Bb^7 C>").voicing().s("sawtooth").lpf(2600).attack(0.2).release(0.8).room(0.5).gain(0.3)
$: n("<[4 5 7 ~] [9 7 5 4] [5 4 2 ~] [4 2 1 ~]>").scale("D4:minor").off(1/8, x => x.add(n(2)).gain(0.2)).s("supersaw").lpf(3400).attack(0.02).release(0.5).delay(0.3).gain(0.35)
$: s("sbd*4").decay(0.35).gain(0.75)
$: s("white*8").decay(0.04).hpf(7000).gain("0.2 0.1")
$: s("~ pink ~ pink").decay(0.12).hpf(1500).gain(0.3)

// --- step 9
$: chord("<Dm7 Dm7 Bb^7 C>").voicing().s("sawtooth").lpf(sine.range(1800, 600).slow(8)).attack(0.4).release(1).room(0.7).gain(0.3)
$: s("crackle*4").density(0.2).gain(0.35)
$: note("~ ~ <a4 f4> ~").s("triangle").room(0.7).release(1).gain(0.35)

// --- step 10
$: note("<d2 [d2 f2] bb1 [c2 c2]>").s("sine").attack(0.1).release(1).gain(0.7)
$: chord("<Dm7 Dm7 Bb^7 C>").voicing().s("sawtooth").lpf(1200).attack(0.3).release(0.8).room(0.6).gain(0.25)
$: n("<[4 ~ 7 ~] [9 ~ 5 4] [5 ~ 2 ~] [4 2 1 ~]>").scale("D4:minor").s("square").lpf(1500).attack(0.02).release(0.3).delay(0.4).gain(0.2)
$: s("sbd ~ sbd ~").decay(0.4).gain(0.65)
$: s("crackle*4").density(0.15).gain(0.25)

// --- step 11
$: note("<d2 d2 a1 d2>").s("sine").attack(0.4).release(1.5).gain(0.65)
$: n("<4 ~ 2 ~> ~ ~ ~").scale("D4:minor").s("triangle").room(0.8).delay(0.5).release(1.2).gain(0.4)
$: s("brown").attack(1).release(1.2).lpf(500).gain(sine.range(0.25, 0.08).slow(8))

// --- step 12
setcpm(20)
$: note("<d2 d2 d2 ~>/2").s("sine").attack(0.6).release(3).gain(0.6)
$: note("<a4 ~ d4 ~ ~ ~ ~ ~>").s("triangle").room(0.9).release(2).gain(0.35)
