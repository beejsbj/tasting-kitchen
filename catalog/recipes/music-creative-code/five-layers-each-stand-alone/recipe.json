{
  "schemaVersion": 1,
  "id": "five-layers-each-stand-alone",
  "version": "0.1.0",
  "status": "ready",
  "title": "Build a piece in five layers that each stand alone",
  "summary": "Write a short piece as five additive layers so that every stage, from the first layer alone to all five, sounds complete.",
  "cuisines": [
    "music-creative-code"
  ],
  "origin": "hybrid",
  "originNote": "Original task with no supplied material; the slow, voice-led direction is the owner's own.",
  "tags": [
    "audio",
    "writing"
  ],
  "kind": "web",
  "harness": {
    "workspace": "write",
    "web": "disabled",
    "capabilities": [
      "files",
      "shell"
    ]
  },
  "setup": {
    "instructions": "Mount the fixtures. The model chooses how to make the sound and may download tools while it works. The delivered page must play without the network.",
    "fixtures": [
      {
        "id": "brief",
        "path": "fixtures/brief.md",
        "mountAs": "fixtures/brief.md",
        "public": true,
        "editable": false,
        "mediaType": "text/markdown"
      }
    ]
  },
  "turns": [
    {
      "id": "build-layers",
      "role": "prompt",
      "content": "Read fixtures/brief.md and do what it asks. Deliver index.html and notes.md in the folder you start in."
    }
  ],
  "output": {
    "kind": "web",
    "entry": "index.html",
    "include": [
      "index.html",
      "notes.md",
      "assets/**"
    ],
    "limits": {
      "maxFiles": 20,
      "maxBytes": 10485760
    }
  },
  "validation": {
    "mode": "files",
    "checks": [
      {
        "id": "page-exists",
        "type": "file-exists",
        "required": true,
        "description": "The playable page exists.",
        "target": "index.html"
      },
      {
        "id": "notes-exist",
        "type": "file-exists",
        "required": true,
        "description": "The listening notes exist.",
        "target": "notes.md"
      },
      {
        "id": "plays-offline",
        "type": "command",
        "required": true,
        "description": "The page loads nothing from the network: no remote script, style, media, import or fetch. Whether it plays is left to tasting.",
        "argv": [
          "node",
          "-e",
          "const fs=require('fs');const h=fs.readFileSync('index.html','utf8');const R=\"\\\\s*[\\\"'`]\\\\s*(?:https?:)?\\\\/\\\\/\";const bad=[new RegExp('\\\\bsrc\\\\s*='+R,'i'),new RegExp('<link\\\\b[^>]*\\\\bhref\\\\s*='+R,'i'),new RegExp('\\\\b(?:import|fetch|importScripts|Audio|Worker|addModule)\\\\s*\\\\('+R,'i'),new RegExp('\\\\bfrom'+R,'i'),new RegExp('url\\\\(\\\\s*[\\\"\\']?\\\\s*(?:https?:)?\\\\/\\\\/','i')];if(bad.some(r=>r.test(h)))process.exit(1)"
        ]
      },
      {
        "id": "listening",
        "type": "manual",
        "required": false,
        "description": "Play the stages in order. Does the first layer alone sound like music, or like a part waiting for the rest? Does each new layer earn its place? At five, is there still air, and does a melody still lead?"
      }
    ]
  },
  "presentation": {
    "profile": "static-web-v1",
    "semanticRuntime": null
  }
}
