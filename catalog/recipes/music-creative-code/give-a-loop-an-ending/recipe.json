{
  "schemaVersion": 1,
  "id": "give-a-loop-an-ending",
  "version": "0.1.0",
  "status": "ready",
  "title": "Give a loop an ending",
  "summary": "Take a four-bar loop that only ever leads back to its own start and bring it to a real ending.",
  "cuisines": [
    "music-creative-code"
  ],
  "origin": "hybrid",
  "originNote": "The loop is original, written for this Recipe so that its last bar leads straight back to its first. It has no ending of its own.",
  "tags": [
    "audio",
    "editing"
  ],
  "kind": "web",
  "harness": {
    "workspace": "write",
    "web": "disabled",
    "capabilities": [
      "files",
      "shell"
    ]
  },
  "setup": {
    "instructions": "Mount the fixtures. The model chooses how to make the sound and may download tools while it works. The delivered page must play without the network.",
    "fixtures": [
      {
        "id": "brief",
        "path": "fixtures/brief.md",
        "mountAs": "fixtures/brief.md",
        "public": true,
        "editable": false,
        "mediaType": "text/markdown"
      },
      {
        "id": "loop",
        "path": "fixtures/loop.json",
        "mountAs": "fixtures/loop.json",
        "public": true,
        "editable": false,
        "mediaType": "application/json"
      }
    ]
  },
  "turns": [
    {
      "id": "end-loop",
      "role": "prompt",
      "content": "Read fixtures/brief.md and fixtures/loop.json and do what the brief asks. Deliver index.html and notes.md in the folder you start in."
    }
  ],
  "output": {
    "kind": "web",
    "entry": "index.html",
    "include": [
      "index.html",
      "notes.md",
      "assets/**"
    ],
    "limits": {
      "maxFiles": 20,
      "maxBytes": 10485760
    }
  },
  "validation": {
    "mode": "files",
    "checks": [
      {
        "id": "page-exists",
        "type": "file-exists",
        "required": true,
        "description": "The playable page exists.",
        "target": "index.html"
      },
      {
        "id": "notes-exist",
        "type": "file-exists",
        "required": true,
        "description": "The listening notes exist.",
        "target": "notes.md"
      },
      {
        "id": "plays-offline",
        "type": "command",
        "required": true,
        "description": "The page loads nothing from the network: no remote script, style, media, import or fetch. Whether it plays is left to tasting.",
        "argv": [
          "node",
          "-e",
          "const fs=require('fs');const h=fs.readFileSync('index.html','utf8');const R=\"\\\\s*[\\\"'`]\\\\s*(?:https?:)?\\\\/\\\\/\";const bad=[new RegExp('\\\\bsrc\\\\s*='+R,'i'),new RegExp('<link\\\\b[^>]*\\\\bhref\\\\s*='+R,'i'),new RegExp('\\\\b(?:import|fetch|importScripts|Audio|Worker|addModule)\\\\s*\\\\('+R,'i'),new RegExp('\\\\bfrom'+R,'i'),new RegExp('url\\\\(\\\\s*[\\\"\\']?\\\\s*(?:https?:)?\\\\/\\\\/','i')];if(bad.some(r=>r.test(h)))process.exit(1)"
        ]
      },
      {
        "id": "listening",
        "type": "manual",
        "required": false,
        "description": "Press play. Does it end, or only stop? Could you feel the ending coming before it arrived? Does the ending belong to this loop, made from what was already there? Were the two passes before it left as written?"
      }
    ]
  },
  "presentation": {
    "profile": "static-web-v1",
    "semanticRuntime": null
  }
}
