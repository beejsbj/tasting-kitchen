{
  "schemaVersion": 1,
  "id": "fix-a-weak-motif",
  "version": "0.1.0",
  "status": "ready",
  "title": "Fix a weak motif with the smallest change",
  "summary": "Say plainly what is wrong with a supplied motif, then make the smallest change that fixes it, playable before and after.",
  "cuisines": [
    "music-creative-code"
  ],
  "origin": "hybrid",
  "originNote": "The weak motif is original, written for this Recipe to be weak in a nameable way. The slow, voice-led direction is the owner's own.",
  "tags": [
    "audio",
    "editing",
    "surgical-change"
  ],
  "kind": "web",
  "harness": {
    "workspace": "write",
    "web": "disabled",
    "capabilities": [
      "files",
      "shell"
    ]
  },
  "setup": {
    "instructions": "Mount the fixtures. The model chooses how to make the sound and may download tools while it works. The delivered page must play without the network.",
    "fixtures": [
      {
        "id": "brief",
        "path": "fixtures/brief.md",
        "mountAs": "fixtures/brief.md",
        "public": true,
        "editable": false,
        "mediaType": "text/markdown"
      },
      {
        "id": "motif",
        "path": "fixtures/weak-motif.json",
        "mountAs": "fixtures/weak-motif.json",
        "public": true,
        "editable": false,
        "mediaType": "application/json"
      }
    ]
  },
  "turns": [
    {
      "id": "fix-motif",
      "role": "prompt",
      "content": "Read fixtures/brief.md and fixtures/weak-motif.json and do what the brief asks. Deliver index.html and notes.md in the folder you start in."
    }
  ],
  "output": {
    "kind": "web",
    "entry": "index.html",
    "include": [
      "index.html",
      "notes.md",
      "assets/**"
    ],
    "limits": {
      "maxFiles": 20,
      "maxBytes": 10485760
    }
  },
  "validation": {
    "mode": "files",
    "checks": [
      {
        "id": "page-exists",
        "type": "file-exists",
        "required": true,
        "description": "The playable page exists.",
        "target": "index.html"
      },
      {
        "id": "notes-exist",
        "type": "file-exists",
        "required": true,
        "description": "The listening notes exist.",
        "target": "notes.md"
      },
      {
        "id": "plays-offline",
        "type": "command",
        "required": true,
        "description": "The page loads nothing from the network: no remote script, style, media, import or fetch. Whether it plays is left to tasting.",
        "argv": [
          "node",
          "-e",
          "const fs=require('fs');const h=fs.readFileSync('index.html','utf8');const R=\"\\\\s*[\\\"'`]\\\\s*(?:https?:)?\\\\/\\\\/\";const bad=[new RegExp('\\\\bsrc\\\\s*='+R,'i'),new RegExp('<link\\\\b[^>]*\\\\bhref\\\\s*='+R,'i'),new RegExp('\\\\b(?:import|fetch|importScripts|Audio|Worker|addModule)\\\\s*\\\\('+R,'i'),new RegExp('\\\\bfrom'+R,'i'),new RegExp('url\\\\(\\\\s*[\\\"\\']?\\\\s*(?:https?:)?\\\\/\\\\/','i')];if(bad.some(r=>r.test(h)))process.exit(1)"
        ]
      },
      {
        "id": "listening",
        "type": "manual",
        "required": false,
        "description": "Play before, then after. Did the model name what is actually wrong? Is the fix small, and is it still this motif? Would you remember the after version tomorrow? Did it resist rewriting the whole thing?"
      }
    ]
  },
  "presentation": {
    "profile": "static-web-v1",
    "semanticRuntime": null
  }
}
