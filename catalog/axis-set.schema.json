{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.burooj.dev/model-tasting/schemas/axis-set.v1.json",
  "title": "Versioned tasting axis set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "title", "purpose", "adapter", "contexts", "axes", "rubricHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["active", "candidate", "retired"] },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "revisionNote": { "type": "string", "minLength": 1 },
    "rubricHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "maxBytes"],
      "properties": {
        "shape": { "enum": ["conversation", "agentic", "journal"] },
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 }
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": { "enum": ["recipe", "menu"] },
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "question", "levels", "consequentialDistance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "consequentialDistance": { "type": "integer", "minimum": 1 },
          "levels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "description"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "label": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
