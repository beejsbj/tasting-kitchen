{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.burooj.dev/model-tasting/schemas/dish.v1.json",
  "title": "Model Tasting Kitchen dish",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "recipe", "executedAt", "finalizedAt", "identity", "status", "artifact", "validation", "dishHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^dish_[a-zA-Z0-9_-]+$" },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "executedAt": { "type": "string", "format": "date-time" },
    "finalizedAt": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "provider", "requestedModel", "observedModel", "harness", "harnessVersion", "reasoningEffort", "serviceTier", "configHash"],
      "properties": {
        "variantId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "requestedModel": { "type": "string", "minLength": 1 },
        "observedModel": { "type": "string", "minLength": 1 },
        "harness": { "type": "string", "minLength": 1 },
        "harnessVersion": { "type": "string", "minLength": 1 },
        "reasoningEffort": { "type": "string", "minLength": 1 },
        "serviceTier": { "type": "string", "minLength": 1 },
        "requestedServiceTier": { "type": "string", "minLength": 1 },
        "observedServiceTier": { "type": "string", "minLength": 1 },
        "configHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "catalogHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "status": { "const": "accepted" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry", "files", "treeHash"],
      "properties": {
        "kind": { "enum": ["web", "image", "code", "session", "document", "audio"] },
        "entry": { "$ref": "#/$defs/relativePath" },
        "preview": { "$ref": "#/$defs/relativePath" },
        "treeHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "report"],
      "properties": {
        "passed": { "const": true },
        "report": { "$ref": "#/$defs/relativePath" }
      }
    },
    "publicTrace": { "$ref": "#/$defs/relativePath" },
    "dishHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    }
  }
}
