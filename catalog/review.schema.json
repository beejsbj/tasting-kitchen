{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.burooj.dev/model-tasting/schemas/review.v1.json",
  "title": "Artifact dish review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "dishId", "dishHash", "reviewer", "reviewerKind", "reviewedAt", "probes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^review_[a-zA-Z0-9_-]+$" },
    "dishId": { "type": "string", "pattern": "^dish_[a-zA-Z0-9_-]+$" },
    "dishHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reviewerKind": { "enum": ["human", "agent"] },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "device", "viewport", "verdict", "finding"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "device": { "type": "string", "minLength": 1, "maxLength": 120 },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
              "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
              "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 8 }
            }
          },
          "verdict": { "enum": ["pass", "issue", "inconclusive"] },
          "finding": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": { "type": "string", "minLength": 1, "maxLength": 120 },
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "scrollWidth": { "type": "integer", "minimum": 0, "maximum": 1000000 },
              "clientWidth": { "type": "integer", "minimum": 0, "maximum": 1000000 }
            }
          }
        }
      }
    }
  }
}
