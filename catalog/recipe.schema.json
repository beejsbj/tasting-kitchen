{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.burooj.dev/model-tasting/schemas/recipe.v1.json",
  "title": "Model Tasting Kitchen recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "title",
    "summary",
    "domain",
    "origin",
    "originNote",
    "tags",
    "kind",
    "harness",
    "setup",
    "turns",
    "output",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "ready", "hidden"] },
    "title": { "type": "string", "minLength": 4, "maxLength": 100 },
    "summary": { "type": "string", "minLength": 12, "maxLength": 300 },
    "domain": { "type": "string" },
    "origin": { "enum": ["textbook", "mothers", "hybrid"] },
    "originNote": { "type": "string", "minLength": 8, "maxLength": 300 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "kind": { "enum": ["web", "image", "code", "session", "document", "audio"] },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "web", "capabilities"],
      "properties": {
        "workspace": { "enum": ["read", "write"] },
        "web": { "enum": ["disabled", "enabled", "closed-sources-only"] },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["files", "shell", "tools", "image-generation", "audio"] }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "fixtures"],
      "properties": {
        "instructions": { "type": "string", "minLength": 1 },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "mountAs", "public"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "path": { "type": "string", "minLength": 1 },
              "mountAs": { "type": "string", "minLength": 1 },
              "public": { "type": "boolean" },
              "mediaType": { "type": "string" }
            }
          }
        }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "role": { "enum": ["prompt", "follow-up", "correction", "mode-transition"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry", "include", "limits"],
      "properties": {
        "kind": { "enum": ["web", "image", "code", "session", "document", "audio"] },
        "entry": { "type": "string", "minLength": 1 },
        "include": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFiles", "maxBytes"],
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 2000 },
            "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "checks"],
      "properties": {
        "mode": { "enum": ["completeness", "files", "interaction", "tests", "trace", "manual"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "required", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "type": { "enum": ["file-exists", "command", "json-schema", "trace-assertion", "manual"] },
              "required": { "type": "boolean" },
              "description": { "type": "string", "minLength": 4 },
              "target": { "type": "string" },
              "argv": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "variation": { "type": "string", "maxLength": 500 },
    "supersedes": { "type": "string" }
  }
}
