          "public": true,
          "editable": false,
          "mediaType": "text/javascript"
        },
        {
          "id": "validator-validate-output-mjs",
          "path": "validation/validate-output.mjs",
          "mountAs": "validation/validate-output.mjs",
          "public": true,
          "editable": false,
          "mediaType": "text/javascript"
        }
      ]
    },
    "turns": [
      {
        "id": "build",
        "role": "prompt",
        "content": "Design and build the Common Measure feature “A Second Life for the Moon.” Give the complete article a sustained editorial composition and make its ledger useful without overstating the figures. Read fixtures/brief.md and both data snapshots; author the visual answer."
      }
    ],
    "output": {
      "kind": "web",
      "entry": "index.html",
      "include": [
        "index.html",
        "styles.css",
        "app.mjs",
        "logic.mjs",
        "data/article.json",
        "data/ledger.json",
        "assets/**"
      ],
      "limits": {
        "maxFiles": 120,
        "maxBytes": 5000000
      }
    },
    "validation": {
      "mode": "tests",
      "checks": [
        {
          "id": "mechanical-contract",
          "type": "command",
          "required": true,
          "description": "Validate required nonempty files, local literal resource/import links, JavaScript syntax, immutable data hashes and shared pure-logic vectors. Does not prove rendering, event wiring, accessibility or taste.",
          "argv": [
            "node",
            "validation/validate-output.mjs"
          ]
        },
        {
          "id": "browser-and-taste",
          "type": "manual",
          "required": false,
          "description": "Read beginning, middle and end at 360px and 1440px. Confirm all seven sections and both notes are rendered intact, measure reading rhythm and editorial hierarchy, operate section/note return links and seasonal ledger via keyboard, inspect units and caveats, and verify no page overflow."
        }
      ]
    },
    "presentation": {
      "profile": "static-web-v1",
      "semanticRuntime": null
    }
  },
