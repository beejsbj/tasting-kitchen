      "instructions": "Read the mounted brief and source/data before editing. Immutable snapshots and validators must remain unchanged; only explicitly editable source fixtures may be edited. Author the missing web output locally in one turn. Ready denotes supported mechanics and static presentation, not a cooked or accepted result.",
      "fixtures": [
        {
          "id": "brief",
          "path": "fixtures/brief.md",
          "mountAs": "fixtures/brief.md",
          "public": true,
          "editable": false,
          "mediaType": "text/markdown"
        },
