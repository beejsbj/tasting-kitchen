{
  "schemaVersion": 1,
  "recipeId": "standard-developer-portfolio",
  "hash": "sha256:8649c94f34c6f0ea1333cd9b9253f27aff118a7079a62e461ede2bfd81fdeaa7",
  "version": "1.0.0",
  "execution": {
    "kind": "web",
    "harness": {
      "workspace": "write",
      "web": "disabled",
      "capabilities": [
        "files",
        "shell"
      ]
    },
    "setup": {
      "instructions": "Read fixtures/brief.md and data/content.json, then author the missing static page locally in one turn. Mounted inputs and validator remain immutable during a Cook. Ready means supported execution mechanics, not a cooked or accepted website.",
      "fixtures": [
        {
          "id": "brief",
          "path": "fixtures/brief.md",
          "mountAs": "fixtures/brief.md",
          "public": true,
          "editable": false,
          "mediaType": "text/markdown"
        },
        {
          "id": "content",
          "path": "fixtures/content.json",
          "mountAs": "data/content.json",
          "public": true,
          "editable": false,
          "mediaType": "application/json"
        },
        {
          "id": "output-validator",
          "path": "validation/validate-output.mjs",
          "mountAs": "validation/validate-output.mjs",
          "public": true,
          "editable": false,
          "mediaType": "text/javascript"
        }
      ]
    },
    "turns": [
      {
        "id": "build",
        "role": "prompt",
        "content": "Build the developer portfolio described in fixtures/brief.md using the complete original fictional packet in data/content.json. Keep the result recognizably conventional and implement the modest ordinary browser interactions specified there. Use local files only, with no dependencies or network."
      }
    ],
    "output": {
      "kind": "web",
      "entry": "index.html",
      "include": [
        "index.html",
        "styles.css",
        "app.mjs",
        "data/content.json",
        "assets/**"
      ],
      "limits": {
        "maxFiles": 40,
        "maxBytes": 2000000
      }
    },
    "validation": {
      "mode": "tests",
      "checks": [
        {
          "id": "output-contract",
          "type": "command",
          "required": true,
          "description": "Check nonempty output, minimal HTML shell and explicit stylesheet/module references, JSON and JavaScript syntax, and common literal local resource paths. Does not prove rendered content, event wiring, accessibility or visual quality.",
          "argv": [
            "node",
            "validation/validate-output.mjs"
          ]
        },
        {
          "id": "browser-and-taste",
          "type": "manual",
          "required": false,
          "description": "Inspect 360px/1440px hierarchy as a hiring portfolio. Filter All/Websites/Product UI (3/2/1), restore All and reach every case study after filtering. Check keyboard use, experience/contact anchors and honest unavailable links."
        }
      ]
    },
    "presentation": {
      "profile": "static-web-v1",
      "semanticRuntime": null
    }
  },
  "fixtures": [
    {
      "id": "brief",
      "path": "fixtures/brief.md",
      "mountAs": "fixtures/brief.md",
      "public": true,
      "editable": false,
      "mediaType": "text/markdown",
      "sha256": "sha256:2a08045ac567c8e6d263f4ea4571fdd0986d9975d39bc02b999734ca66ede938",
      "contentBase64": ""
    },
    {
      "id": "content",
      "path": "fixtures/content.json",
      "mountAs": "data/content.json",
      "public": true,
      "editable": false,
      "mediaType": "application/json",
      "sha256": "sha256:fc035e4e61676a91e7e0e6795a3b3628343e506c0093b917b948f0f00fe4929b",
      "contentBase64": ""
    },
    {
      "id": "output-validator",
      "path": "validation/validate-output.mjs",
      "mountAs": "validation/validate-output.mjs",
      "public": true,
      "editable": false,
      "mediaType": "text/javascript",
      "sha256": "sha256:b03225fe6461c89adb483a371a124858c14c71c8eea98fdd324dab6733d2a7c9",
      "contentBase64": ""
    }
  ],
  "display": {
    "title": "Developer portfolio",
    "summary": "A typical frontend developer portfolio with supplied case studies, experience and a project filter.",
    "lineage": "textbook",
    "cuisines": [
      "ui-visual",
      "ux-interaction"
    ]
  }
}
