{
  "schemaVersion": 1,
  "recipeId": "standard-developer-homepage",
  "hash": "sha256:f0fd767c99d02a6d3a341d0f3bff41cd265c399231447bccefb9983af6ef281a",
  "version": "1.0.0",
  "execution": {
    "kind": "web",
    "harness": {
      "workspace": "write",
      "web": "disabled",
      "capabilities": [
        "files",
        "shell"
      ]
    },
    "setup": {
      "instructions": "Read fixtures/brief.md and data/content.json, then author the missing static page locally in one turn. Mounted inputs and validator remain immutable during a Cook. Ready means supported execution mechanics, not a cooked or accepted website.",
      "fixtures": [
        {
          "id": "brief",
          "path": "fixtures/brief.md",
          "mountAs": "fixtures/brief.md",
          "public": true,
          "editable": false,
          "mediaType": "text/markdown"
        },
        {
          "id": "content",
          "path": "fixtures/content.json",
          "mountAs": "data/content.json",
          "public": true,
          "editable": false,
          "mediaType": "application/json"
        },
        {
          "id": "output-validator",
          "path": "validation/validate-output.mjs",
          "mountAs": "validation/validate-output.mjs",
          "public": true,
          "editable": false,
          "mediaType": "text/javascript"
        }
      ]
    },
    "turns": [
      {
        "id": "build",
        "role": "prompt",
        "content": "Build the developer-tool homepage described in fixtures/brief.md using the complete original fictional packet in data/content.json. Keep the result recognizably conventional and implement the modest ordinary browser interactions specified there. Use local files only, with no dependencies or network."
      }
    ],
    "output": {
      "kind": "web",
      "entry": "index.html",
      "include": [
        "index.html",
        "styles.css",
        "app.mjs",
        "data/content.json",
        "assets/**"
      ],
      "limits": {
        "maxFiles": 40,
        "maxBytes": 2000000
      }
    },
    "validation": {
      "mode": "tests",
      "checks": [
        {
          "id": "output-contract",
          "type": "command",
          "required": true,
          "description": "Check nonempty output, minimal HTML shell and explicit stylesheet/module references, JSON and JavaScript syntax, and common literal local resource paths. Does not prove rendered content, event wiring, accessibility or visual quality.",
          "argv": [
            "node",
            "validation/validate-output.mjs"
          ]
        },
        {
          "id": "browser-and-taste",
          "type": "manual",
          "required": false,
          "description": "Inspect 360px/1440px familiar Tailwind idiom and readable code/prices. Verify exact clipboard text after success, rejection/unavailable fallback, FAQ keyboard toggles, every local plan preview and no network actions."
        }
      ]
    },
    "presentation": {
      "profile": "static-web-v1",
      "semanticRuntime": null
    }
  },
  "fixtures": [
    {
      "id": "brief",
      "path": "fixtures/brief.md",
      "mountAs": "fixtures/brief.md",
      "public": true,
      "editable": false,
      "mediaType": "text/markdown",
      "sha256": "sha256:903e36bded8749111b95c302afb2496880bf0100117a4afa652270438ce68115",
      "contentBase64": ""
    },
    {
      "id": "content",
      "path": "fixtures/content.json",
      "mountAs": "data/content.json",
      "public": true,
      "editable": false,
      "mediaType": "application/json",
      "sha256": "sha256:58f036f0449ea36304f3310f05b219c0cfb061b90a43d61fb865b1428833e18f",
      "contentBase64": ""
    },
    {
      "id": "output-validator",
      "path": "validation/validate-output.mjs",
      "mountAs": "validation/validate-output.mjs",
      "public": true,
      "editable": false,
      "mediaType": "text/javascript",
      "sha256": "sha256:b03225fe6461c89adb483a371a124858c14c71c8eea98fdd324dab6733d2a7c9",
      "contentBase64": ""
    }
  ],
  "display": {
    "title": "Developer-tool homepage",
    "summary": "A familiar Tailwind-style developer-tool homepage with code, pricing, FAQ and honest command copying.",
    "lineage": "textbook",
    "cuisines": [
      "ui-visual",
      "ux-interaction"
    ]
  }
}
