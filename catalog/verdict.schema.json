{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.burooj.dev/model-tasting/schemas/verdict.v1.json",
  "title": "A judge's verdict attached beside an immutable Dish or No Dish",
  "description": "Append-only. The newest verdict from the highest-ranked judge stands; the owner (Burooj) outranks every automated check. Validated at runtime by lib/taste/verdicts.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "plateId", "plateHash", "judge", "verdict", "note", "decidedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^verdict_[a-zA-Z0-9_-]+$" },
    "plateId": { "type": "string", "pattern": "^(dish|nodish)_[a-zA-Z0-9_-]+$" },
    "plateHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["owner"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "verdict": { "enum": ["failed", "passed"] },
    "note": { "type": "string", "minLength": 1, "maxLength": 500 },
    "decidedAt": { "type": "string", "format": "date-time" }
  }
}
